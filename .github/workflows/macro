name: Macro — brief et presse

# 7h45 : le brief du jour, avec l'aperçu de la semaine le lundi.
# 13h00 : la revue de presse, avant les publications américaines de 14h30.

on:
  schedule:
    - cron: "45 5 * * 1-5"     # 7h45 Paris
    - cron: "00 11 * * 1-5"    # 13h00 Paris
  workflow_dispatch:
    inputs:
      mode:
        description: "Mode"
        required: false
        default: "auto"
        type: choice
        options: [auto, brief, semaine]

permissions:
  contents: write

jobs:
  macro:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-python@v6
        with:
          python-version: "3.12"
          cache: pip
      - run: pip install yfinance pandas numpy requests anthropic
      - name: Brief et presse
        env:
          TELEGRAM_JETON: ${{ secrets.TELEGRAM_JETON }}
          TELEGRAM_DESTINATAIRE: ${{ secrets.TELEGRAM_DESTINATAIRE }}
          CLE_ANTHROPIC: ${{ secrets.CLE_ANTHROPIC }}
          ANTHROPIC_WORKSPACE_ID: ${{ secrets.ANTHROPIC_WORKSPACE_ID }}
          MODE_MACRO: ${{ inputs.mode || 'auto' }}
        run: python veille_macro.py
      - name: Mémoriser
        if: always()
        run: |
          if [[ -n $(git status --porcelain articles_vus.json) ]]; then
            git config user.name "veille"
            git config user.email "veille@users.noreply.github.com"
            git add articles_vus.json
            git commit -m "Presse : etat"
            git pull --rebase --autostash || true
            git push
          fi
